{
  "name": "portafolio-serverless",
  "scripts": {
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "studio": "prisma studio",
    "generate": "wrangler d1 migrations create valdez-ai create_table",
    "migrate": "prisma migrate diff --from-empty --to-schema-datamodel ./prisma/schema.prisma --script --output migrations/0001_create_table.sql",
    "deploy:local": "prisma migrate reset --force && wrangler d1 migrations apply valdez-ai --local",
    "deploy:remote": "prisma migrate reset --force && wrangler d1 migrations apply valdez-ai --remote"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.4.1",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "hono": "^4.6.16",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.10.7",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "prisma": "^6.4.1",
    "wrangler": "^4.40.3"
  }
}
